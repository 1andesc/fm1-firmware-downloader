diff --git a/firmware/hal/fm1_flash_id.h b/firmware/hal/fm1_flash_id.h
new file mode 100644
index 0000000..b1d32ee
--- /dev/null
+++ b/firmware/hal/fm1_flash_id.h
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Experimental UC25HQ80 compatibility, 2026-11-02.
+ * Explicit 1 MiB SPI NOR allowlist; do NOT accept capacity byte alone.
+ * UCUN UC25HQ80 datasheet v1.2: RDID B3 60 14, 256-byte PP (02h),
+ * 4 KiB SE (20h), RDSR (05h), WREN (06h), fast read (0Bh).
+ * Does not change write ranges, status/protection bits, or erase/program commands.
+ * Specification-checked and host-tested only; NOT hardware-qualified.
+ */
+#pragma once
+#include <stdint.h>
+static inline int fl_jedec_supported(uint32_t id)
+{
+    return id == 0x856014u || id == 0xB36014u;
+}
