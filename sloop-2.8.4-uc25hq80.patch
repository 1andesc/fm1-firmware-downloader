diff --git a/tests/uc_compat_tests.sh b/tests/uc_compat_tests.sh
new file mode 100644
index 0000000..700e7d3
--- /dev/null
+++ b/tests/uc_compat_tests.sh
@@ -0,0 +1,22 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-only
+# Focused HOST/SIMULATED-NOR suite, not hardware qualification. Build firmware first.
+set -eu
+cd "$(dirname "$0")/.."
+OUT=build/host/uc
+mkdir -p "$OUT"
+CC=${CC:-cc}
+for t in flash_id storage recovery; do
+    "$CC" -O2 -Wall -Wno-unused-function -o "$OUT/${t}_test" "tests/${t}_test.c"
+    "$OUT/${t}_test"
+done
+"$CC" -O2 -w -Ibuild/gen -Ifirmware/src -Ifirmware/hal -o "$OUT/uc_persist_test" tests/uc_persist_test.c -lm
+"$OUT/uc_persist_test"
+"$CC" -O2 -w -o "$OUT/ota_test" tests/ota_test.c
+"$OUT/ota_test" build/felucca.fwsc
+head -c 200000 build/felucca.bin > "$OUT/old_app.bin"
+python3 tools/fm1pkg_make.py "$OUT/old_app.bin" build/loader/ota.bin "$OUT/old.fwsc"
+"$CC" -O2 -w -o "$OUT/ldr_test" tests/ldr_test.c
+"$OUT/ldr_test" "$OUT/old.fwsc" build/felucca.fwsc
+python3 tests/install_test.py
+echo 'ALL FOCUSED UC COMPATIBILITY HOST TESTS PASSED (NO HARDWARE TEST)'
diff --git a/tests/uc_persist_test.c b/tests/uc_persist_test.c
new file mode 100644
index 0000000..39cbcc5
--- /dev/null
+++ b/tests/uc_persist_test.c
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* Real persist_boot/project_save/proj_fetch, RAM-backed NOR, NOT a hardware test. */
+#include "editor_host.c"
+int main(void)
+{
+    const uint32_t ids[] = {0x856014u, 0xB36014u, 0u, 0xFFFFFFu, 0xEF4014u};
+    unsigned k;
+    static project_t saved;
+    for (k = 0; k < sizeof ids / sizeof ids[0]; ++k) {
+        host_flash_id = ids[k];
+        fl_erases = fl_progs = fl_bad = 0;
+        flash_ok = 0;
+        song.playing = 0; transport_req = 0;
+        memset(proj_slot, 0, sizeof proj_slot);
+        harness_init();
+        assert(flash_ok == (k < 2));
+        /* Boot must not format or erase a chip as a side effect. */
+        assert(fl_erases == 0 && fl_progs == 0);
+        song.g[G_BPM] = 137;
+        project_save(0);
+        if (k < 2) {
+            assert(fl_erases > 0 && fl_progs > 0 && fl_bad == 0);
+            saved = proj_slot[0];
+            assert(proj_ok(&saved));
+            /* Discard the cached project, re-read from simulated NOR. */
+            memset(&proj_slot[0], 0, sizeof proj_slot[0]);
+            proj_fetch(0);
+            assert(proj_ok(&proj_slot[0]));
+            assert(memcmp(&saved, &proj_slot[0], sizeof saved) == 0);
+            assert(proj_slot[0].g[G_BPM] == 137);
+            /* No write to bootloader, app or the factory tail. */
+            for (unsigned i = 0; i < 0x97000; ++i) assert(nor[i] == 0xFF);
+            for (unsigned i = 0xFF000; i < sizeof nor; ++i) assert(nor[i] == 0xFF);
+        } else {
+            assert(fl_erases == 0 && fl_progs == 0 && fl_bad == 0);
+        }
+        printf("persist ID 0x%06X: %s\n", ids[k], k < 2 ? "real project save + cache discard + NOR reload PASS" : "no erase/program on unknown chip PASS");
+    }
+    return 0;
+}
