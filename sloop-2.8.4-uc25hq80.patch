diff --git a/tests/flash_id_test.c b/tests/flash_id_test.c
new file mode 100644
index 0000000..8c6a52e
--- /dev/null
+++ b/tests/flash_id_test.c
@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include "../firmware/hal/fm1_flash_id.h"
+int main(void) {
+    uint32_t id, accepted = 0;
+    for (id = 0; id <= 0xFFFFFFu; ++id) {
+        int ok = fl_jedec_supported(id);
+        assert(ok == (id == 0x856014u || id == 0xB36014u));
+        accepted += !!ok;
+    }
+    assert(accepted == 2 && !fl_jedec_supported(0xFFFFFFFFu));
+    assert(!fl_jedec_supported(0x01856014u) && !fl_jedec_supported(0x01B36014u));
+    puts("flash ID: all 24-bit IDs checked; exactly two accepted; read failures refused");
+    return 0;
+}
